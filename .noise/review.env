# Which identity posts this repository's review verdicts. Policy only: app
# ids, installation ids, and key paths stay in the reviewer's own profile
# fragments outside every repo.
#
# Always read from the pull request's BASE ref, so a branch cannot nominate
# its own reviewer. Treat changes here like CODEOWNERS changes.
REVIEWER_LOGIN=noise-review[bot]
REVIEWER_PROFILE=noise-review
